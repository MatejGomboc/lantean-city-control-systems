{
    // Files owned by repository owner - do not modify
    // GitHub issue templates have their own format requirements
    // Third-party packages, build output
    "ignores": [
        "CODE_OF_CONDUCT.md",
        ".github/ISSUE_TEMPLATE/**",
        "**/node_modules/**",
        "**/target/**",
        "**/.svelte-kit/**",
        "clients/*/build/**"
    ]
}
